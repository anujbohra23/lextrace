# Required only for CourtListener ingestion commands. Export this in your shell.
# .env files are not loaded automatically. Never commit a real token.
COURTLISTENER_API_TOKEN=

# Required only for `lextrace research`; choose the exact provider model ID.
OPENAI_API_KEY=
LEXTRACE_LLM_MODEL=
# Optional for another API-compatible endpoint.
OPENAI_BASE_URL=

# Local production runtime. Generated databases remain under ignored artifacts/.
LEXTRACE_INDEX_PATH=artifacts/indexes/default
LEXTRACE_GRAPH_PATH=artifacts/graphs/default
LEXTRACE_RUNTIME_DB=artifacts/runtime/lextrace.sqlite3
LEXTRACE_CACHE_DB=artifacts/runtime/cache.sqlite3
LEXTRACE_MATTER_DB=artifacts/runtime/matters.sqlite3
LEXTRACE_PRIVATE_MATTER_ROOT=artifacts/runtime/private_matters
LEXTRACE_PERSIST_CONTENT=true
LEXTRACE_MAX_CONCURRENT_RESEARCH=1
LEXTRACE_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_LEXTRACE_API_URL=http://localhost:8000
